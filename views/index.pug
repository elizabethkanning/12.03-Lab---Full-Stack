extends layout

block content
  h1= title
  p Welcome to #{title}!
  ol
  each val in todos
    li
      span.task= val.task + ' - '
      if val.completed > 0
        span.complete Completed
      else
        span.complete Not Completed
      form(method='POST' action='/edit')
        input(type='text', name='task', value=val.task.trim(), required)
        input(type='hidden', name='id', value=val.id)
        button.update(type='submit') Update Description
      form(method='POST' action='/markComplete')
        input(type='hidden', name='id', value=val.id)
        button.markComplete(type='submit') Mark Complete
      form(method='POST' action='/delete')
        input(type='hidden', name='id', value=val.id)
        button.delete(type='submit') Delete

  hr
  h2 Add a new task
  form(method='POST' action='/create')
    label(for='task') Task:
    input(type='text', name='task', id='task', required)
    button(type='submit') Create Task
